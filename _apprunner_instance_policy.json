{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3DocumentBucketAccess",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::obligra-documents-961308088417-dev/*"
        },
        {
            "Sid": "DynamoDBTableAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:GetItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchWriteItem",
                "dynamodb:BatchGetItem"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-documents",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-documents/index/*",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-obligations",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-obligations/index/*",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-obligation-relationships",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-obligation-relationships/index/*",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-users",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-users/index/*",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-sources",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-sources/index/*",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-telegram-links",
                "arn:aws:dynamodb:us-east-1:961308088417:table/obligra-telegram-link-codes"
            ]
        },
        {
            "Sid": "TextractAccess",
            "Effect": "Allow",
            "Action": [
                "textract:StartDocumentTextDetection",
                "textract:GetDocumentTextDetection"
            ],
            "Resource": "*"
        },
        {
            "Sid": "BedrockInvokeAccess",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel"
            ],
            "Resource": [
                "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0",
                "arn:aws:bedrock:*::foundation-model/amazon.nova-pro-v1:0"
            ]
        }
    ]
}
