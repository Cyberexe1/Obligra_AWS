APP_NAME=OBLIGRA API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]

# --- AWS ---
# Credentials: prefer an attached IAM role (EC2/ECS/Lambda) in real
# deployments. For local development, set the standard AWS SDK env vars
# below (never commit real values). Do NOT rename these - they are read
# directly by boto3's default credential chain, not by app/config.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- S3 ---
# Bucket names in AWS are globally unique. The convention used here is
# obligra-documents-<aws-account-id>-<env>.
S3_BUCKET_NAME=obligra-documents-123456789012-dev
S3_UPLOAD_PREFIX=uploads/

# --- Upload validation ---
MAX_UPLOAD_SIZE_MB=15

# --- Textract ---
TEXTRACT_POLL_INTERVAL_SECONDS=1.0
TEXTRACT_POLL_TIMEOUT_SECONDS=60.0

# --- Bedrock ---
# Model must be enabled/accessible in your AWS account and region. Some
# providers (e.g. Anthropic) require an AWS Marketplace subscription and/or
# an inference profile ARN instead of a bare model ID - check your
# account's Bedrock model access page if invocation fails.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0

# --- DynamoDB ---
DYNAMODB_DOCUMENTS_TABLE=obligra-documents
DYNAMODB_OBLIGATIONS_TABLE=obligra-obligations
DYNAMODB_OBLIGATION_RELATIONSHIPS_TABLE=obligra-obligation-relationships
DYNAMODB_USERS_TABLE=obligra-users
DYNAMODB_SOURCES_TABLE=obligra-sources
DYNAMODB_TELEGRAM_LINKS_TABLE=obligra-telegram-links
DYNAMODB_TELEGRAM_LINK_CODES_TABLE=obligra-telegram-link-codes

# --- Authentication ---
# JWT_SECRET_KEY is required - the app will fail to start without it.
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret. Rotating this value invalidates all
# existing tokens (all users would need to log in again).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Telegram ---
# Create a bot via @BotFather on Telegram to obtain a token. Optional -
# leave blank to run without Telegram integration enabled.
TELEGRAM_BOT_TOKEN=
# Optional: set this to a random secret and register the SAME value with
# Telegram's setWebhook (secret_token param) so incoming webhook calls
# can be verified via the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# How long a generated /link-code stays valid, in minutes.
TELEGRAM_LINK_CODE_TTL_MINUTES=10
